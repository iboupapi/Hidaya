PORT=3000
JWT_SECRET=

# Configuration PostgreSQL native
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hidaya

# URL de connexion unique utilisée par Prisma
DATABASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Stockage S3-compatible (Cloudflare R2 / Backblaze B2 / AWS S3) — Point 2
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
# URL publique de base servant à construire les liens des fichiers (audio/image),
# ex: https://pub-xxxx.r2.dev  ou  https://cdn.votre-domaine.com
S3_PUBLIC_URL=

# Redis — cache pour la page d'accueil et les audios populaires — Point 3
REDIS_URL=

# CORS — domaines autorisés à appeler l'API, séparés par des virgules — Point 5
# En local, laissez tel quel. En production, remplacez par votre vrai domaine,
# ex: CORS_ORIGINS=https://hidaya.sn,https://www.hidaya.sn
CORS_ORIGINS=

ADMIN_EMAIL=
ADMIN_PASSWORD=