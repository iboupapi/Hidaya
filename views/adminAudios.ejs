<section class="admin-audio-section">
  <h2 class="section-title">🎧 Gestion des audios</h2>

  <% if (audios.length === 0) { %>
    <p class="no-audio">Aucun audio disponible.</p>
  <% } else { %>
    <div class="search-bar-wrapper">
  <input type="text" id="audioSearchInput" placeholder=" Rechercher un audio..." class="search-input">
</div>

    <ul class="audio-list">
      <% audios.forEach(audio => { %>
        <li class="audio-item">
          <!-- Lecture -->
          <button class="play-button" onclick="togglePlay('<%= audio.id %>')" id="btn-<%= audio.id %>">
            <img src="/images/play.svg" alt="Lecture">
          </button>

          <!-- Infos -->
          <div class="audio-info">
            <span class="audio-title"><%= audio.title %></span>
            <p class="audio-description"><%= audio.description %></p>
            <p class="audio-meta">
              Catégorie : <%= audio.main_category %>
              <% if (audio.sub_category) { %> | Sous-catégorie : <%= audio.sub_category %> <% } %>
            </p>
          </div>

          <!-- Options -->
          <div class="audio-options">
  <audio id="audio-<%= audio.id %>" src="/<%= audio.file_path %>"></audio>

  <a href="/<%= audio.file_path %>" download class="download-link" title="Télécharger">
    <img src="/images/download.svg" alt="Télécharger" width="27px">
  </a>

  <a href="/admin/audios/<%= audio.id %>/edit" class="edit-link">✏️ Modifier</a>
  <a href="/admin/audios/<%= audio.id %>/playlists" class="playlist-link">📂 Playlists</a>

  <form action="/admin/audios/<%= audio.id %>/delete" method="POST" onsubmit="return confirm('Supprimer cet audio ?')" class="delete-form">
    <button type="submit" class="delete-button">🗑️ Supprimer</button>
  </form>
</div>

        </li>
      <% }) %>
    </ul>
  <% } %>
</section>

<script>
  const audioPlayers = {};

  function togglePlay(id) {
    const audio = document.getElementById(`audio-${id}`);
    const btn = document.getElementById(`btn-${id}`);
    const img = btn.querySelector('img');

    if (!audioPlayers[id]) {
      audioPlayers[id] = audio;
    }

    Object.keys(audioPlayers).forEach(key => {
      if (key !== id) {
        audioPlayers[key].pause();
        audioPlayers[key].currentTime = 0;
        const otherBtn = document.getElementById(`btn-${key}`);
        const otherImg = otherBtn?.querySelector('img');
        if (otherImg) otherImg.src = '/images/play.svg';
      }
    });

    if (audio.paused) {
      audio.play();
      img.src = '/images/pause.svg';
    } else {
      audio.pause();
      img.src = '/images/play.svg';
    }

    audio.onended = () => {
      img.src = '/images/play.svg';
    };
  }

  document.getElementById('audioSearchInput').addEventListener('input', function () {
    const query = this.value.toLowerCase();
    const items = document.querySelectorAll('.audio-item');

    items.forEach(item => {
      const title = item.querySelector('.audio-title')?.textContent.toLowerCase() || '';
      const description = item.querySelector('.audio-description')?.textContent.toLowerCase() || '';
      const match = title.includes(query) || description.includes(query);
      item.style.display = match ? 'flex' : 'none';
    });
  });
</script>

