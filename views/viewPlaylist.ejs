<section style="padding: 30px 20px; max-width: 700px; margin: auto;">
  <h2 style="margin-bottom: 20px;">📂 Playlist : <%= playlist.name %></h2>

  <% if (audios.length === 0) { %>
    <p style="color: #ccc;">Aucun audio dans cette playlist.</p>
  <% } else { %>
    <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
      <% audios.forEach(audio => { %>
        <div style="background-color: #1a1a1a; padding: 20px; border-radius: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.2);">
          <h3 style="color: white; margin-bottom: 10px;"><%= audio.title %></h3>
          <p style="color: #ccc;"><%= audio.description %></p>
          <audio controls style="width: 100%; margin-top: 10px;">
            <source src="/<%= audio.file_path %>" type="audio/mpeg">
            Votre navigateur ne supporte pas la lecture audio.
          </audio>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div style="margin-top: 30px; display: flex; justify-content: space-between;">
    <a href="/playlists" class="header-button">📂 Retour à mes playlists</a>
    <a href="/dashboard" class="header-button">🏠 Tableau de bord</a>
  </div>
</section>
