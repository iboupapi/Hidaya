<section class="playlist-add-container">
  <h2 class="section-title">🎵 Ajouter un audio à la playlist</h2>

  <form action="/playlists/<%= playlistId %>/add" method="POST" class="playlist-form">
    <label for="audio_id">Sélectionnez un audio :</label>
    <select name="audio_id" id="audio_id" required>
      <% audios.forEach(audio => { %>
        <option value="<%= audio.id %>"><%= audio.title %></option>
      <% }) %>
    </select>
    <label for="playlist_id">Choisissez une playlist :</label>
<select name="playlist_id" id="playlist_id" required>
  <% playlists.forEach(pl => { %>
    <option value="<%= pl.id %>"><%= pl.name %></option>
  <% }) %>
</select>

    <button type="submit" class="submit-button">➕ Ajouter à la playlist</button>
  </form>

  <div class="back-button-wrapper">
    <a href="/dashboard" class="back-button">🏠 Retour au tableau de bord</a>
  </div>
</section>
