<h2>🛠️ Modifier l’audio</h2>
<form action="/admin/audios/<%= audio.id %>/edit" method="POST">
  <label for="title">Titre :</label>
  <input type="text" name="title" id="title" value="<%= audio.title %>" required />

  <label for="description">Description :</label>
  <textarea name="description" id="description"><%= audio.description %></textarea>

  <label for="main_category">Catégorie principale :</label>
  <select name="main_category" id="main_category">
    <option value="emission" <%= audio.main_category === 'emission' ? 'selected' : '' %>>Émission</option>
    <option value="musique" <%= audio.main_category === 'musique' ? 'selected' : '' %>>Musique</option>
    <option value="enseignement" <%= audio.main_category === 'enseignement' ? 'selected' : '' %>>Enseignement</option>
  </select>

  <% if (audio.main_category === 'enseignement') { %>
    <label for="sub_category">Sous-catégorie :</label>
    <select name="sub_category" id="sub_category">
      <option value="rappel" <%= audio.sub_category === 'rappel' ? 'selected' : '' %>>Rappel</option>
      <option value="conference" <%= audio.sub_category === 'conference' ? 'selected' : '' %>>Conférence</option>
      <option value="bayane" <%= audio.sub_category === 'bayane' ? 'selected' : '' %>>Bayane</option>
    </select>
  <% } %>

  <button type="submit">💾 Enregistrer</button>
</form>
