<h2>Modifier l’audio : <%= audio.title %></h2>

<form action="/admin/audios/<%= audio.id %>/edit" method="POST">
  <label>Titre :</label>
  <input type="text" name="title" value="<%= audio.title %>" required />

  <label>Description :</label>
  <textarea name="description"><%= audio.description %></textarea>

  <label>Catégorie :</label>
  <select name="category" required>
    <option value="rappel" <%= audio.category === 'rappel' ? 'selected' : '' %>>Rappel</option>
    <option value="enseignement" <%= audio.category === 'enseignement' ? 'selected' : '' %>>Enseignement</option>
    <option value="conférence" <%= audio.category === 'conférence' ? 'selected' : '' %>>Conférence</option>
  </select>

  <label>Thème :</label>
  <select name="theme_id" required>
    <% themes.forEach(theme => { %>
      <option value="<%= theme.id %>" <%= audio.theme_id === theme.id ? 'selected' : '' %>><%= theme.name %></option>
    <% }) %>
  </select>

  <button type="submit">💾 Enregistrer</button>
</form>

<a href="/admin/audios">🔙 Retour à la liste des audios</a>
