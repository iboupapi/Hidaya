<section style="padding: 30px 20px; max-width: 600px; margin: auto;">
  <h2 style="text-align: center;"><%= audio.title %></h2>

  <div style="text-align: center;">
    <img src="/<%= audio.image_path || 'images/audio-default.jpg' %>" alt="Illustration audio" style="width: 100%; max-height: 300px; object-fit: cover; border-radius: 10px; margin-bottom: 20px;" />
  </div>

  <p><%= audio.description %></p>

  <p class="audio-meta">
    Catégorie : <%= audio.main_category %>
    <% if (audio.main_category === 'enseignement' && audio.sub_category) { %>
      | Sous-catégorie : <%= audio.sub_category %>
    <% } %>
  </p>

  <audio controls style="width: 100%; margin-top: 20px;">
    <source src="/<%= audio.file_path %>" type="audio/mpeg">
  </audio>

  <!-- 📥 Télécharger -->
  <div style="margin-top: 20px; text-align: center;">
    <a href="/<%= audio.file_path %>" download class="header-button" style="display: inline-block;">
      📥 Télécharger l'audio
    </a>
  </div>

  <!-- ❤️ Ajouter aux favoris -->
  <form action="/favorites/add/<%= audio.id %>" method="POST" style="margin-top: 20px; text-align: center;">
    <button type="submit" class="favorite-button">❤️ Ajouter aux favoris</button>
  </form>

  <!-- 📂 Ajouter à une playlist -->
  <% if (session && session.userId) { %>
    <div style="margin-top: 30px;">
      <h4>📂 Ajouter à une playlist</h4>

      <% if (playlists && playlists.length > 0) { %>
        <form action="/playlists/add/<%= audio.id %>" method="POST">
          <select name="playlist_id" required style="padding: 8px; border-radius: 6px; margin-right: 10px;">
            <% playlists.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.name %></option>
            <% }) %>
          </select>
          <button type="submit" class="header-button">Ajouter</button>
        </form>
      <% } else { %>
        <p style="color: #ccc;">Aucune playlist trouvée.</p>
        <a href="/playlists/create" class="header-button">➕ Créer une playlist</a>
      <% } %>
    </div>
  <% } %>
</section>
