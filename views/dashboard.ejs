<section class="dashboard-container">
  <h2 class="dashboard-title">👋 Bienvenue sur Hidaya</h2>

  

  <div class="dashboard-links">
    <a href="/audios" class="dashboard-card">
      <div class="card-icon">🎧</div>
      <div class="card-content">
        <h3>Voir les audios</h3>
        <p>Accédez à tous les contenus audio par catégorie.</p>
      </div>
    </a>

    <a href="/favorites" class="dashboard-card">
      <div class="card-icon">❤️</div>
      <div class="card-content">
        <h3>Mes favoris</h3>
        <p>Retrouvez les audios que vous avez aimés.</p>
      </div>
    </a>

    <a href="/playlists" class="dashboard-card">
      <div class="card-icon">📂</div>
      <div class="card-content">
        <h3>Mes playlists</h3>
        <p>Gérez vos collections personnelles d’audios.</p>
      </div>
    </a>

    <% if (session && session.userRole === 'admin') { %>
      <a href="/admin/dashboard" class="dashboard-card">
        <div class="card-icon">🛠️</div>
        <div class="card-content">
          <h3>Espace admin</h3>
          <p>Gérez les contenus et les utilisateurs.</p>
        </div>
      </a>
    <% } %>
  </div>
</section>
