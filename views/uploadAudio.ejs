<h2>Uploader un audio</h2>
<form action="/admin/upload" method="POST" enctype="multipart/form-data">
  <input type="text" name="title" placeholder="Titre" required />
  <textarea name="description" placeholder="Description"></textarea>
  <input type="file" name="audio" accept="audio/*" required />
<label>Image illustrative :</label>
  <input type="file" name="image" accept="image/*" required/>
  <label for="main_category">Catégorie principale :</label>
  <select name="main_category" id="main_category" required>
    <option value="enseignement">Enseignement</option>
    <option value="emission">Émission</option>
    <option value="musique">Musique</option>
  </select>

  <div id="subCategoryContainer" style="display:none;">
    <label for="sub_category">Sous-catégorie :</label>
    <select name="sub_category" id="sub_category">
      <option value="">-- Aucun --</option>
      <option value="rappel">Rappel</option>
      <option value="conference">Conférence</option>
      <option value="bayane">Bayane</option>
    </select>
  </div>

  <button type="submit">Uploader</button>
</form>

<script>
  const mainCategory = document.getElementById('main_category');
  const subCategoryContainer = document.getElementById('subCategoryContainer');

  mainCategory.addEventListener('change', function () {
    if (this.value === 'enseignement') {
      subCategoryContainer.style.display = 'block';
    } else {
      subCategoryContainer.style.display = 'none';
      document.getElementById('sub_category').value = '';
    }
  });

  // Initialisation au chargement
  window.addEventListener('DOMContentLoaded', () => {
    if (mainCategory.value === 'enseignement') {
      subCategoryContainer.style.display = 'block';
    }
  });
</script>
