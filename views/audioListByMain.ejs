<section class="category-audio-container">
  <h2 class="section-title">🎧 Audios : <%= main %></h2>

  <% if (main === 'enseignement') { %>
    <% const categories = [
      { label: 'Rappel', key: 'rappel' },
      { label: 'Conférence', key: 'conference' },
      { label: 'Bayane', key: 'bayane' }
    ]; %>

    <% categories.forEach(cat => {
         const filtered = audios.filter(a => a.sub_category === cat.key).slice(0, 3); %>

      <h3><%= cat.label %></h3>
      <div class="see-more-wrapper">
        <a href="/audios/<%= main %>/<%= cat.key %>" class="see-more-link">
          ➡️ Voir tous les audios de <%= cat.label %>
        </a>
      </div>

      <% if (filtered.length === 0) { %>
        <div class="audio-empty">
          <p>Aucun audio disponible pour cette sous-catégorie.</p>
        </div>
      <% } else { %>
        <div class="audio-grid">
          <% filtered.forEach(audio => { %>
            <div class="audio-card">
              <img src="/<%= audio.image_path || 'images/audio-default.jpg' %>" class="audio-image" />
              <div class="audio-content">
                <h4><a href="/audios/view/<%= audio.id %>" class="audio-title-link"><%= audio.title %></a></h4>
                <p><%= audio.description %></p>
                <audio controls><source src="/<%= audio.file_path %>" type="audio/mpeg"></audio>
              </div>
              <% if (session && session.userId) { %>
                <a href="/audios/download/<%= audio.id %>" class="download-button">⬇️ Télécharger</a>
              <% } else { %>
                <p class="download-disabled">🔒 Connectez-vous pour télécharger</p>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    <% }) %>

  <% } else { %>
    <% if (audios.length === 0) { %>
      <div class="audio-empty">
        <p>Aucun audio trouvé pour cette catégorie.</p>
      </div>
    <% } else { %>
      <div class="audio-grid">
  <% audios.forEach(audio => { %>
    <div class="audio-card">
      <img src="/<%= audio.image_path || 'images/audio-default.jpg' %>" class="audio-image" />
      <div class="audio-content">
        <h4>
          <a href="/audios/view/<%= audio.id %>" class="audio-title-link"><%= audio.title %></a>
        </h4>
        <p><%= audio.description %></p>
        <audio controls>
          <source src="/<%= audio.file_path %>" type="audio/mpeg">
        </audio>

        <% if (session && session.userId) { %>
          <a href="/audios/download/<%= audio.id %>" class="download-button">⬇️ Télécharger</a>
        <% } else { %>
          <p class="download-disabled">🔒 Connectez-vous pour télécharger</p>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

    <% } %>
  <% } %>

  <div class="back-button-wrapper">
    <a href="/dashboard" class="back-button">🏠 Retour au tableau de bord</a>
  </div>
</section>

<script>
  const audioPlayers = {};

  function togglePlay(id) {
    const audio = document.getElementById(`audio-${id}`);
    const btn = document.getElementById(`btn-${id}`);
    const img = btn.querySelector('img');

    if (!audioPlayers[id]) {
      audioPlayers[id] = audio;
    }

    // Pause tous les autres
    Object.keys(audioPlayers).forEach(key => {
      if (key !== id) {
        audioPlayers[key].pause();
        audioPlayers[key].currentTime = 0;
        const otherBtn = document.getElementById(`btn-${key}`);
        const otherImg = otherBtn?.querySelector('img');
        if (otherImg) otherImg.src = '/images/play.svg';
      }
    });

    // Toggle lecture/pause
    if (audio.paused) {
      audio.play();
      img.src = '/images/pause.svg';
    } else {
      audio.pause();
      img.src = '/images/play.svg';
    }

    // Reset bouton quand audio se termine
    audio.onended = () => {
      img.src = '/images/play.svg';
    };
  }
</script>
