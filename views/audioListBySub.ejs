<section class="audio-list-section">
  <h2 class="section-title"> Enseignement : <%= sub %></h2>

  <% if (audios.length === 0) { %>
    <p class="no-audio">Aucun audio trouvé.</p>
  <% } else { %>
    <ul class="audio-list">
      <% audios.forEach(audio => { %>
        <li class="audio-item">
          <!-- Bouton lecture/pause -->
          <button class="play-button" onclick="togglePlay('<%= audio.id %>')" id="btn-<%= audio.id %>"><img src="/images/play.svg" alt=""></button>

          <!-- Info audio -->
          <div class="audio-info">
            <span class="audio-title"><%= audio.title %></span>
            <p class="audio-description"><%= audio.description %></p>
          </div>

          <!-- Options -->
          <!-- Options -->
           <form action="/favorites/add/<%= audio.id %>" method="POST" style="margin-top: 10px;">
            <button type="submit" class="favorite-button"><img src="/images/like.svg" alt="" width="20px"> Ajouter aux favoris</button>
          </form>
<div class="audio-options">
  <audio id="audio-<%= audio.id %>" src="/<%= audio.file_path %>"></audio>
  <a href="/<%= audio.file_path %>" download class="download-link" title="Télécharger l'audio"><img src="/images/download.svg" alt="" width="27px"></a>
</div>

        </li>
      <% }) %>
    </ul>
  <% } %>

  <div class="back-link-wrapper">
    <a href="/audios/category/enseignement" class="back-link"><img src="/images/ic-back_97586.svg" alt="" class="back"> Retour à Enseignement</a>
  </div>
</section>
<script>
  const audioPlayers = {};

  function togglePlay(id) {
    const audio = document.getElementById(`audio-${id}`);
    const btn = document.getElementById(`btn-${id}`);
    const img = btn.querySelector('img');
    if (!audioPlayers[id]) {
      audioPlayers[id] = audio;
    }

    // Pause tous les autres
    Object.keys(audioPlayers).forEach(key => {
      if (key !== id) {
        audioPlayers[key].pause();
        audioPlayers[key].currentTime = 0;
        const otherBtn = document.getElementById(`btn-${key}`);
        const otherImg = otherBtn.querySelector('img');
      if (otherImg) otherImg.src = '/images/play.svg';
      }
    });

    // Toggle lecture/pause
    if (audio.paused) {
      audio.play();
      img.src = '/images/pause.svg';
    } else {
      audio.pause();
      img.src = '/images/play.svg';
    }

    // Reset bouton quand audio se termine
    audio.onended = () => {
      img.src = '/images/play.svg';
    };
  }
</script>
